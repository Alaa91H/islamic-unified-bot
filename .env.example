# ============================================================================
# Islamic Unified Bot — Environment Variables
# ============================================================================

# --- بيانات Telegram (إلزامية) ---
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE
OWNER_ID=YOUR_OWNER_ID_HERE

# --- المسارات ---
MUSIC_DIR=./music
AZAN_DATA_DIR=./azan_data
DATA_DIR=./data
LOGS_DIR=./logs
SESSION_NAME=islamic_unified_bot
# pyrogram هو الافتراضي الكامل. aiogram مسار تجريبي لأوامر /start و/help فقط؛ يبقي البث معطّلًا.
TELEGRAM_RUNTIME=pyrogram
DB_PATH=./data/bot.db

# --- مصادر الصوت ---
QURAN_STREAM_URL=https://server8.mp3quran.net/afs/

# --- البث ---
MAX_RECONNECT_ATTEMPTS=10
INITIAL_RECONNECT_DELAY=5
AUDIO_QUALITY=studio

# --- الصلاة ---
DEFAULT_CALCULATION_METHOD=mwl
DEFAULT_ASR_METHOD=standard
DEFAULT_CITY=مكة المكرمة
DEFAULT_TIMEZONE=3

# --- التنبيهات ---
NOTIFICATIONS_ENABLED=true
PRELUDE_ENABLED=false
PRELUDE_TIME=5

# --- البث التلقائي ---
STREAM_ENABLED=false
DEFAULT_AZAN_SOURCE=traditional
DEFAULT_PRELUDE_SOURCE=traditional
STREAM_STOP_BEFORE=0
DEFAULT_STREAM_DURATION=120

# --- قاعدة البيانات ---
DB_TYPE=sqlite

# --- الأمان والسجلات ---
SAFE_MODE=true
LOG_SENSITIVE_DATA=false
REQUEST_TIMEOUT=10
MAX_RETRIES=3
DEBUG_MODE=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# ============================================================================
# إعدادات الخادم الضعيف (Oracle Cloud Free Tier — 1GB RAM)
# هذه الإعدادات موصى بها للنشر على خادم Oracle المجاني
# ============================================================================

# الوضع الخفيف: يقلّل استهلاك الذاكرة عبر gc.collect عند الإقلاع
LIGHTWEIGHT_MODE=true

# حجم تجمّع قاعدة البيانات (الأقل = ذاكرة أقل)
DB_POOL_SIZE=3

# مهلة طلبات API (الثواني)
API_TIMEOUT=5

# مدة بقاء الـ cache (ثواني)
CACHE_TTL=3600

# أقصى عدد بثات متزامنة (خفّضه على الخوادم الضعيفة)
MAX_CONCURRENT_STREAMS=2

# فترة دورة الجدولة بالثواني (60 = دقيقة)
SCHEDULER_TICK_SECONDS=60

# --- Telegram Mini App API (اختيارية) ---
# اتركها false إذا كانت الواجهة تستخدم sendData فقط.
# عند التفعيل، أبقِ الخدمة محلية خلف reverse proxy HTTPS واضبط النطاق الدقيق للواجهة.
MINIAPP_API_ENABLED=false
MINIAPP_API_HOST=127.0.0.1
MINIAPP_API_PORT=8080
MINIAPP_INIT_DATA_MAX_AGE=3600
MINIAPP_ALLOWED_ORIGIN=https://your-miniapp.example.com
# حد طلبات API المتزامنة؛ يكفي للواجهة الصغيرة ويحمي العملية الأساسية للبوت.
MINIAPP_API_CONCURRENCY_LIMIT=50

# ============================================================================
# مراقب الذاكرة الداخلي
# العتبة الافتراضية 600MB — أقل من حد systemd MemoryMax (700M)
# لتسمح للبوت بتنظيف نفسه قبل أن يقتله OOM killer
# ============================================================================
HIGH_MEMORY_THRESHOLD_MB=600
